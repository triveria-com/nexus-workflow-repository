{
  "name": "DPP Manufacturer (UNTP)",
  "description": "Verifies supplier passports, publishes its own UNTP Digital Product Passport and one Make record per supplier product. On the UNTP trust framework, anchored by a Digital Identity Anchor.",
  "summary": "DPP Manufacturer wallet for workflows/dpp-workflow.md on the UNTP trust framework (role member): the issuers and verifier of noop/dpp_manufacturer, but every DID it verifies must be anchored by a Digital Identity Anchor chained to a registrar it trusts, and it onboards with a DIA from a registrar (untp/registrar) before others can verify what it signs. It verifies supplier passports, publishes its product passport and Make records, and requires a DIA of every passport, Make record and DCC issuer it verifies.",
  "config": {
    "trustFramework": "UNTP",
    "walletKeyIdentifier": "did",
    "credentialIssuers": [
      {
        "id": "product_passport",
        "name": "Product Passport",
        "credentialFormat": "jwt_vc_vcdm",
        "credentialType": "VerifiableCredential,DigitalProductPassport",
        "credentialIssuer": "IssuanceQueue",
        "signingKeyIdentifier": "did",
        "numericStatusListIndex": true
      },
      {
        "id": "make_event",
        "name": "Make Record",
        "credentialFormat": "jwt_vc_vcdm",
        "credentialType": "VerifiableCredential,DigitalTraceabilityEvent",
        "credentialIssuer": "IssuanceQueue",
        "signingKeyIdentifier": "did",
        "numericStatusListIndex": true
      }
    ],
    "credentialVerifiers": [
      {
        "id": "dcc_disclosure",
        "name": "DPP: Digital Conformity Credential",
        "dcqlQuery": {
          "credentials": [
            {
              "id": "dcc",
              "format": "jwt_vc_json",
              "meta": {
                "type_values": [
                  [
                    "DigitalConformityCredential"
                  ]
                ]
              },
              "claims": [
                {
                  "path": [
                    "id"
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "UNTP": {
      "isOnboarded": false,
      "role": "member",
      "issuerPolicy": [
        {
          "credentialType": "DigitalProductPassport",
          "requireDia": true
        },
        {
          "credentialType": "DigitalTraceabilityEvent",
          "requireDia": true
        },
        {
          "credentialType": "DigitalConformityCredential",
          "requireDia": true
        }
      ]
    }
  }
}
