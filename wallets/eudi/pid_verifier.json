{
  "name": "EUDI PID Verifier",
  "description": "Verifies Person Identification Data (PID) credentials from an EUDI wallet using a DCQL query",
  "summary": "Wallet on the EUDI trust framework (ETSI list of trusted lists, x509 key identifier) that verifies Person Identification Data (PID) credentials of type eu.europa.ec.eudi.pid.1 presented by an EUDI wallet. Verification uses a DCQL query with the dc+sd-jwt format, the query language to use with the EUDI Reference Wallet, requesting selective disclosure of family_name, given_name and age_over_18 and verifying credential expiration.",
  "config": {
    "trustFramework": "EUDI",
    "walletKeyIdentifier": "x509",
    "EUDI": {
      "etsiLotlUrl": "https://webuild-consortium.github.io/wp4-trust-group/list_of_trusted_lists.xml",
      "trustedLotlCertificates": [
        ""
      ]
    },
    "credentialVerifiers": [
      {
        "id": "pid",
        "name": "Person Identification Data",
        "dcqlQuery": {
          "credentials": [
            {
              "id": "pid",
              "format": "dc+sd-jwt",
              "meta": {
                "vct_values": ["eu.europa.ec.eudi.pid.1"]
              },
              "claims": [
                { "id": "family_name", "path": ["family_name"] },
                { "id": "given_name", "path": ["given_name"] },
                { "id": "age_over_18", "path": ["age_over_18"] }
              ]
            }
          ]
        },
        "toVerify": ["verifyExpiration"]
      }
    ],
    "oidcRevision": {
      "oidc4vci": "Draft15",
      "oidc4vp": "Draft23"
    }
  }
}
