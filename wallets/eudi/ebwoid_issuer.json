{
  "name": "EBWOID Issuer",
  "description": "Issue and verify European Business Wallet Owner Identification Data (EBWOID) credentials as Pub-EAA or QEAA",
  "summary": "Wallet on the EUDI trust framework (ETSI list of trusted lists, x509 key identifier) that issues and verifies European Business Wallet Owner Identification Data (EBWOID) credentials of type uri:eu.ebw.oid.1 in sd_jwt_vc format, as Pub-EAA or QEAA.",
  "config": {
    "trustFramework": "EUDI",
    "walletKeyIdentifier": "x509",
    "EUDI": {
      "etsiLotlUrl": "https://webuild-consortium.github.io/wp4-trust-group/list_of_trusted_lists.xml",
      "trustedLotlCertificates": [""]
    },
    "credentialIssuers": [
      {
        "id": "ebwoid",
        "name": "EBW Owner Identification Data",
        "description": "Issue EBWOID credential identifying an economic operator or public sector body",
        "credentialFormat": "sd_jwt_vc",
        "credentialIssuer": "IssuanceQueue",
        "credentialType": "uri:eu.ebw.oid.1"
      }
    ],
    "credentialVerifiers": [
      {
        "id": "ebwoid",
        "name": "EBW Owner Identification Data",
        "description": "Verify EBWOID credential of an economic operator or public sector body",
        "presentationDefinition": {
          "format": {
            "jwt_vc": { "alg": ["ES256"] },
            "jwt_vp": { "alg": ["ES256"] }
          },
          "id": "ebwoid_presentation",
          "input_descriptors": [
            {
              "id": "ebwoid",
              "constraints": {
                "fields": [
                  {
                    "filter": { "const": "uri:eu.ebw.oid.1", "type": "string" },
                    "path": ["$.vct"]
                  },
                  { "name": "Business Identifier (EUID)", "path": ["$.id"] },
                  { "name": "Legal Name", "path": ["$.name"] },
                  { "name": "Issuing Country", "path": ["$.issuing_country"] }
                ]
              }
            }
          ]
        }
      }
    ],
    "oidcRevision": {
      "oidc4vci": "Draft15",
      "oidc4vp": "Draft23"
    }
  }
}
